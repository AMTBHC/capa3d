# Copia este archivo como deploy/.env (instalar.sh lo crea por ti).

# Tu dominio, sin https:// (debe apuntar a la IP de este servidor).
DOMINIO=capa3d.co
# Correo para el certificado HTTPS (Let's Encrypt avisa ahí si algo falla).
CORREO=tu@correo.com

# Clave del panel /admin. Usa una larga: el panel queda en internet.
CLAVE_PANEL=

# Lo que se muestra en el sitio.
WHATSAPP=573001234567
CORREO_CONTACTO=hola@capa3d.co

# Wompi (opcional; sin estas llaves los pagos se marcan a mano en el panel).
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_PRIVATE_KEY=
