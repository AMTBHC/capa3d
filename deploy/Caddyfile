# Caddy pide y renueva solo el certificado HTTPS (Let's Encrypt) para tu dominio.
{
	email {$CORREO}
}

{$DOMINIO} {
	encode zstd gzip

	# La API: cotizaciones, pedidos, pagos y panel. Los archivos de clientes pueden pesar
	# hasta 100 MB, y las actualizaciones en vivo (SSE) no se deben retener.
	handle /api/* {
		request_body {
			max_size 110MB
		}
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	# Archivos del sitio con nombre único por versión: se guardan para siempre.
	handle /_next/static/* {
		reverse_proxy web:3000
	}

	# Las páginas: Next las marca para guardarse un año (s-maxage) y algunos navegadores, como
	# el de Instagram o Facebook, siguen mostrando la versión vieja. Que siempre pregunten si hay
	# una nueva (con el ETag, si no cambió no se vuelve a descargar).
	handle {
		reverse_proxy web:3000 {
			header_down Cache-Control "no-cache"
		}
	}
}

# www.tudominio.com lleva al dominio principal.
www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}
