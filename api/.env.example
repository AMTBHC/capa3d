# Carpeta donde se guardan archivos subidos, G-code y la base de datos
CAPA3D_DATA_DIR=./data
# Ejecutable de PrusaSlicer (vacío = buscar "prusa-slicer" en el PATH)
CAPA3D_SLICER_PATH=
# Ejecutable de OpenSCAD para los llaveros con nombre (vacío = buscarlo en el PATH o en Program Files)
CAPA3D_OPENSCAD_PATH=
# Lista de productos que se importan al catálogo al arrancar (vacío = no importar)
# CAPA3D_CATALOG_IMPORT=
# Orígenes del sitio web que pueden llamar a la API, separados por coma
CAPA3D_CORS_ORIGINS=http://localhost:3000
# Clave del panel de pedidos (http://localhost:3000/admin). iniciar.bat / iniciar.command la generan solos.
CAPA3D_ADMIN_TOKEN=
# Dirección pública del sitio (enlaces de pedido y regreso desde Wompi)
CAPA3D_SITE_URL=http://localhost:3000
# Wompi: comercios.wompi.co → Desarrolladores. Usa las llaves de prueba (pub_test_…) para probar.
CAPA3D_WOMPI_PUBLIC_KEY=
CAPA3D_WOMPI_INTEGRITY_SECRET=
CAPA3D_WOMPI_EVENTS_SECRET=
# Opcional: llave privada (prv_test_… / prv_prod_…). Con ella el pago se confirma solo aunque el sitio
# corra en tu computador, donde Wompi no puede devolver al cliente ni enviar eventos.
CAPA3D_WOMPI_PRIVATE_KEY=
